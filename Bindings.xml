<Bindings>
    <!-- Esc > Options > Keybindings > AddOns > Timesaver.
         Names come from BINDING_NAME_* globals in Core.lua.
         The header goes on the first binding only. -->
    <Binding name="TIMESAVER_AUTOLOOT" header="TIMESAVER" category="ADDONS">
        Timesaver_ToggleFeature("autoLoot")
    </Binding>
    <Binding name="TIMESAVER_AUTOQUEST" category="ADDONS">
        Timesaver_ToggleFeature("autoQuest")
    </Binding>
    <Binding name="TIMESAVER_SKIPTRIVIAL" category="ADDONS">
